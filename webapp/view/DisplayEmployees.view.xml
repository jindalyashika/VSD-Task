<mvc:View
    controllerName="project1.controller.DisplayEmployees"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    displayBlock="true">

    <Page
        title="{i18n>displayEmployeesTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding">

        <content>

            <Table
                id="empTable8"
                items="{
                    path: '/Employees',
                    parameters: {
                        expand: 'department,designation'
                    },
                    sorter: {
                        path: 'createdAt',
                        descending: false
                    }
                }"
                growing="true"
                growingThreshold="20"
                sticky="ColumnHeaders,HeaderToolbar"
                noDataText="{i18n>noEmployees}">

                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>employees}"/>

                        <ToolbarSpacer/>

                        <SearchField
                            width="18rem"
                            placeholder="{i18n>searchPlaceholder}"
                            search=".onSearch"/>
                    </OverflowToolbar>
                </headerToolbar>

                <columns>

                    <!-- Employee Image -->
                    <Column width="5rem" hAlign="Center">
                        <Text text="Photo"/>
                    </Column>

                    <!-- Employee ID -->
                    <Column width="6rem">
                        <Text text="{i18n>colId}"/>
                    </Column>

                    <!-- Employee Name -->
                    <Column>
                        <Text text="{i18n>colName}"/>
                    </Column>

                    <!-- Department -->
                    <Column
                        minScreenWidth="Tablet"
                        demandPopin="true">
                        <Text text="{i18n>colDepartment}"/>
                    </Column>

                    <!-- Designation -->
                    <Column
                        minScreenWidth="Tablet"
                        demandPopin="true">
                        <Text text="{i18n>colJobRole}"/>
                    </Column>

                    <!-- Location -->
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true">
                        <Text text="{i18n>colLocation}"/>
                    </Column>

                    <!-- Joining Date -->
                    <Column
                        minScreenWidth="Desktop"
                        demandPopin="true">
                        <Text text="{i18n>colJoined}"/>
                    </Column>

                    <!-- Status -->
                    <Column>
                        <Text text="{i18n>colStatus}"/>
                    </Column>

                </columns>

                <items>
                    <ColumnListItem vAlign="Middle">

                        <cells>
           <!-- for employee profile -->
                          <Avatar
    src="{
        path: '__metadata/media_src',
        formatter: '.formatImageUrl'
    }"
    displayShape="Circle"
    displaySize="S"
    fallbackIcon="sap-icon://employee"
/>

                            <!-- Employee ID -->
                            <Text text="{employeeId}"/>

                            <!-- Employee Name -->
                            <ObjectIdentifier
                                title="{
                                    parts: [
                                        {path: 'firstName'},
                                        {path: 'lastName'}
                                    ],
                                    formatter: '.formatter.fullName'
                                }"
                                text="{email}"/>

                            <!-- Department -->
                            <Text text="{department/name}"/>

                            <!-- Designation -->
                            <Text text="{designation/description}"/>

                            <!-- Location -->
                            <Text text="{location}"/>

                            <!-- Joining Date -->
                            <Text
                                text="{
                                    path: 'joiningDate',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: {
                                        style: 'medium',
                                        UTC: true
                                    }
                                }"/>

                            <!-- Status -->
                            <ObjectStatus
                                text="{status}"
                                state="{
                                    path: 'status',
                                    formatter: '.formatter.statusState'
                                }"/>

                        </cells>

                    </ColumnListItem>
                </items>

            </Table>

        </content>

    </Page>

</mvc:View>