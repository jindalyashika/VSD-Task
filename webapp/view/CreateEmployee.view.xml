
<mvc:View
    controllerName="project1.controller.CreateEmployee"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:unified="sap.ui.unified"
    displayBlock="true">

    <Page
        title="{i18n>createEmployeeTitle}"
        showNavButton="true"
        navButtonPress=".onNavBack"
        class="sapUiResponsiveContentPadding">

        <content>
            <VBox class="sapUiMediumMargin">

                <!-- Employee Profile Image -->
                <Panel
                    headerText="Employee Profile Picture"
                    class="sapUiSmallMarginBottom">

                    <HBox
                        alignItems="Center"
                        justifyContent="Center"
                        class="sapUiMediumMargin"
                        wrap="Wrap">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center">

                            <Avatar
                                displaySize="XL"
                                displayShape="Circle"
                                src="{form>/emp/imagePreview}"
                                fallbackIcon="sap-icon://employee"/>

                            <Text
                                text="Upload Employee Photo"
                                class="sapUiSmallMarginTop"/>

                            <unified:FileUploader
                                id="employeeImageUploader"
                                name="empImg"
                                width="250px"
                                buttonText="Choose Image"
                                fileType="jpg,jpeg,png"
                                mimeType="image/jpeg,image/png"
                                maximumFileSize="5"
                                uploadOnChange="false"
                                sendXHR="true"
                                useMultipart="false"
                                httpRequestMethod="Put"
                                change=".onImageChange"
                                uploadComplete=".onImageUploadComplete"/>

                            <Text
                                text="Allowed formats: JPG, JPEG, PNG (Maximum 5 MB)"
                                class="sapUiTinyMarginTop"
                                wrapping="true"/>
                        </VBox>
                    </HBox>
                </Panel>

                <f:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="4"
                    labelSpanL="4"
                    labelSpanM="4"
                    labelSpanS="12"
                    emptySpanXL="0"
                    emptySpanL="0"
                    emptySpanM="0"
                    emptySpanS="0"
                    columnsXL="2"
                    columnsL="2"
                    columnsM="1"
                    singleContainerFullSize="false">

                    <f:content>

                        <!-- Personal Information -->
                        <core:Title text="{i18n>secPersonal}"/>

                        <Label text="{i18n>lblEmployeeId}"/>
                        <Input
                            value="{form>/emp/employeeId}"
                            editable="false"/>

                        <Label text="{i18n>lblFirstName}" required="true"/>
                        <Input
                            value="{form>/emp/firstName}"
                            maxLength="100"
                            valueState="{form>/state/firstName}"
                            valueStateText="{form>/msg/firstName}"
                            change=".onFieldEdit($event, 'firstName')"/>

                        <Label text="{i18n>lblLastName}" required="true"/>
                        <Input
                            value="{form>/emp/lastName}"
                            maxLength="100"
                            valueState="{form>/state/lastName}"
                            valueStateText="{form>/msg/lastName}"
                            change=".onFieldEdit($event, 'lastName')"/>

                        <Label text="{i18n>lblEmail}" required="true"/>
                        <Input
                            value="{form>/emp/email}"
                            type="Email"
                            maxLength="150"
                            valueState="{form>/state/email}"
                            valueStateText="{form>/msg/email}"
                            change=".onFieldEdit($event, 'email')"/>

                        <Label text="{i18n>lblPhone}" required="true"/>
                        <Input
                            value="{form>/emp/phone}"
                            type="Tel"
                            maxLength="15"
                            valueState="{form>/state/phone}"
                            valueStateText="{form>/msg/phone}"
                            change=".onFieldEdit($event, 'phone')"/>

                        <Label text="{i18n>lblDob}" required="true"/>
                        <DatePicker
                            dateValue="{form>/emp/dob}"
                            displayFormat="dd MMM yyyy"
                            valueState="{form>/state/dob}"
                            valueStateText="{form>/msg/dob}"
                            change=".onFieldEdit($event, 'dob')"/>

                        <Label text="{i18n>lblCurrentAddress}" required="true"/>
                        <TextArea
                            value="{form>/emp/currentAddress}"
                            rows="2"
                            maxLength="500"
                            valueState="{form>/state/currentAddress}"
                            valueStateText="{form>/msg/currentAddress}"
                            change=".onFieldEdit($event, 'currentAddress')"/>

                        <Label text="{i18n>lblPermanentAddress}" required="true"/>
                        <TextArea
                            value="{form>/emp/permanentAddress}"
                            rows="2"
                            maxLength="500"
                            valueState="{form>/state/permanentAddress}"
                            valueStateText="{form>/msg/permanentAddress}"
                            change=".onFieldEdit($event, 'permanentAddress')"/>

                        <!-- Employment Information -->
                        <core:Title text="{i18n>secJob}"/>

                        <Label text="{i18n>lblDepartment}" required="true"/>
                        <ComboBox
                            selectedKey="{form>/emp/department_ID}"
                            items="{path: '/Departments', sorter: {path: 'name'}}"
                            valueState="{form>/state/department_ID}"
                            valueStateText="{form>/msg/department_ID}"
                            selectionChange=".onFieldEdit($event, 'department_ID')">
                            <core:Item key="{ID}" text="{name}"/>
                        </ComboBox>

                        <Label text="{i18n>lblJobRole}" required="true"/>
                        <ComboBox
                            selectedKey="{form>/emp/designation_ID}"
                            items="{path: '/Designations', sorter: {path: 'description'}}"
                            valueState="{form>/state/designation_ID}"
                            valueStateText="{form>/msg/designation_ID}"
                            selectionChange=".onFieldEdit($event, 'designation_ID')">
                            <core:ListItem
                                key="{ID}"
                                text="{description}"
                                additionalText="{code}"/>
                        </ComboBox>

                        <Label text="{i18n>lblLocation}"/>
                        <Input value="{form>/emp/location}" maxLength="100"/>

                        <Label text="{i18n>lblJoiningDate}" required="true"/>
                        <DatePicker
                            dateValue="{form>/emp/joiningDate}"
                            displayFormat="dd MMM yyyy"
                            valueState="{form>/state/joiningDate}"
                            valueStateText="{form>/msg/joiningDate}"
                            change=".onFieldEdit($event, 'joiningDate')"/>

                        <Label text="{i18n>lblStatus}"/>
                        <Select selectedKey="{form>/emp/status}">
                            <core:Item key="Active" text="{i18n>statusActive}"/>
                            <core:Item key="Inactive" text="{i18n>statusInactive}"/>
                        </Select>

                    </f:content>
                </f:SimpleForm>
            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <ToolbarSpacer/>
                <Button
                    text="{i18n>save}"
                    type="Emphasized"
                    press=".onSave"/>
                <Button
                    text="{i18n>reset}"
                    press=".onReset"/>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>