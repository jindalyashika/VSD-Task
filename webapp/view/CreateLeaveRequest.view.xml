
<mvc:View
    controllerName="project1.controller.CreateLeaveRequest"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    displayBlock="true">

    <Page
        title="Create Leave Request"
        showNavButton="true"
        navButtonPress=".onNavBack">

        <content>

            <VBox class="sapUiMediumMargin">

                <Title
                    text="Employee Leave Application"
                    level="H2"
                    class="sapUiSmallMarginBottom"/>

                <form:SimpleForm
                    editable="true"
                    layout="ResponsiveGridLayout"
                    labelSpanXL="3"
                    labelSpanL="3"
                    labelSpanM="4"
                    labelSpanS="12"
                    adjustLabelSpan="false"
                    emptySpanXL="1"
                    emptySpanL="1"
                    emptySpanM="0"
                    emptySpanS="0"
                    columnsXL="1"
                    columnsL="1"
                    columnsM="1"
                    singleContainerFullSize="true">

                    <!-- Employee Name -->
                    <Label
                        text="Employee Name"
                        required="true"/>

                    <Input
                        id="employeeNameInput"
                        placeholder="Type employee name"
                        showSuggestion="true"
                        filterSuggests="false"
                        suggest=".onSuggestEmployeeName"
                        suggestionItemSelected=".onEmployeeNameSelected"
                        liveChange=".onEmployeeNameLiveChange"
                        suggestionItems="{employees>/list}">

                        <suggestionItems>
                            <core:ListItem
                                key="{employees>ID}"
                                text="{employees>fullName}"
                                additionalText="{employees>employeeId}"/>
                        </suggestionItems>

                    </Input>

                    <!-- Employee ID -->
                    <Label
                        text="Employee ID"
                        required="true"/>

                    <Input
                        id="employeeIdInput"
                        placeholder="Type employee ID"
                        showSuggestion="true"
                        filterSuggests="false"
                        suggest=".onSuggestEmployeeId"
                        suggestionItemSelected=".onEmployeeIdSelected"
                        liveChange=".onEmployeeIdLiveChange"
                        suggestionItems="{employees>/list}">

                        <suggestionItems>
                            <core:ListItem
                                key="{employees>ID}"
                                text="{employees>employeeId}"
                                additionalText="{employees>fullName}"/>
                        </suggestionItems>

                    </Input>

                    <!-- Leave Type -->
                    <Label
                        text="Leave Type"
                        required="true"/>

                    <Select
                        id="leaveTypeSelect"
                        width="100%"
                        selectedKey="">

                        <items>
                            <core:Item
                                key="Casual Leave"
                                text="Casual Leave"/>

                            <core:Item
                                key="Sick Leave"
                                text="Sick Leave"/>

                            <core:Item
                                key="Annual Leave"
                                text="Annual Leave"/>

                            <core:Item
                                key="Unpaid Leave"
                                text="Unpaid Leave"/>
                        </items>

                    </Select>

                    <!-- Start Date -->
                    <Label
                        text="Start Date"
                        required="true"/>

                    <DatePicker
                        id="startDatePicker"
                        width="100%"
                        displayFormat="dd MMM yyyy"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select start date"/>

                    <!-- End Date -->
                    <Label
                        text="End Date"
                        required="true"/>

                    <DatePicker
                        id="endDatePicker"
                        width="100%"
                        displayFormat="dd MMM yyyy"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select end date"/>

                    <!-- Reason -->
                    <Label
                        text="Reason"
                        required="true"/>

                    <TextArea
                        id="reasonInput"
                        rows="4"
                        width="100%"
                        placeholder="Enter reason for leave"/>

                </form:SimpleForm>

                <!-- Buttons -->
                <HBox
                    width="100%"
                    justifyContent="End"
                    alignItems="Center"
                    class="sapUiMediumMarginTop">

                    <Button
                        text="Clear"
                        type="Transparent"
                        press=".onClear"
                        class="sapUiTinyMarginEnd"/>

                    <Button
                        text="Submit Request"
                        type="Emphasized"
                        icon="sap-icon://accept"
                        press=".onSubmitLeaveRequest"/>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>