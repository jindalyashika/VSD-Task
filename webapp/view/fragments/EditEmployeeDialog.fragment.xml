
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form">

    <Dialog
        id="editDialog"
        title="{i18n>updateEmployeeTitle}"
        contentWidth="52rem"
        stretch="{device>/system/phone}">

        <content>

            <f:SimpleForm
                editable="true"
                layout="ResponsiveGridLayout"
                labelSpanXL="4"
                labelSpanL="4"
                labelSpanM="4"
                labelSpanS="12"
                emptySpanXL="0"
                emptySpanL="0"
                emptySpanM="0"
                emptySpanS="0"
                columnsXL="2"
                columnsL="2"
                columnsM="1"
                singleContainerFullSize="false">

                <f:content>

                    <!-- PERSONAL INFORMATION -->

                    <core:Title text="{i18n>secPersonal}"/>

                    <Label text="{i18n>lblEmployeeId}"/>
                    <Input
                        value="{form>/emp/employeeId}"
                        editable="false"/>

                    <Label text="{i18n>lblFirstName}" required="true"/>
                    <Input
                        value="{form>/emp/firstName}"
                        maxLength="100"
                        valueState="{form>/state/firstName}"
                        valueStateText="{form>/msg/firstName}"
                        change=".onFirstNameChange"/>

                    <Label text="{i18n>lblLastName}" required="true"/>
                    <Input
                        value="{form>/emp/lastName}"
                        maxLength="100"
                        valueState="{form>/state/lastName}"
                        valueStateText="{form>/msg/lastName}"
                        change=".onLastNameChange"/>

                    <Label text="{i18n>lblEmail}" required="true"/>
                    <Input
                        value="{form>/emp/email}"
                        type="Email"
                        maxLength="150"
                        valueState="{form>/state/email}"
                        valueStateText="{form>/msg/email}"
                        change=".onEmailChange"/>

                    <Label text="{i18n>lblPhone}" required="true"/>
                    <Input
                        value="{form>/emp/phone}"
                        type="Tel"
                        maxLength="15"
                        valueState="{form>/state/phone}"
                        valueStateText="{form>/msg/phone}"
                        change=".onPhoneChange"/>

                    <Label text="{i18n>lblDob}" required="true"/>
                    <DatePicker
                        dateValue="{form>/emp/dob}"
                        displayFormat="dd MMM yyyy"
                        valueState="{form>/state/dob}"
                        valueStateText="{form>/msg/dob}"
                        change=".onDobChange"/>

                    <Label text="{i18n>lblCurrentAddress}" required="true"/>
                    <TextArea
                        value="{form>/emp/currentAddress}"
                        rows="2"
                        maxLength="500"
                        showExceededText="true"
                        valueState="{form>/state/currentAddress}"
                        valueStateText="{form>/msg/currentAddress}"
                        change=".onCurrentAddressChange"/>

                    <Label text="{i18n>lblPermanentAddress}" required="true"/>
                    <TextArea
                        value="{form>/emp/permanentAddress}"
                        rows="2"
                        maxLength="500"
                        showExceededText="true"
                        valueState="{form>/state/permanentAddress}"
                        valueStateText="{form>/msg/permanentAddress}"
                        change=".onPermanentAddressChange"/>


                    <!-- JOB INFORMATION -->

                    <core:Title text="{i18n>secJob}"/>

                    <Label text="{i18n>lblDepartment}" required="true"/>

                    <ComboBox
                        selectedKey="{form>/emp/department_ID}"
                        placeholder="{i18n>phDepartment}"
                        items="{
                            path: '/Departments',
                            sorter: {
                                path: 'name'
                            }
                        }"
                        valueState="{form>/state/department_ID}"
                        valueStateText="{form>/msg/department_ID}"
                        selectionChange=".onDepartmentChange">

                        <core:Item
                            key="{ID}"
                            text="{name}"/>

                    </ComboBox>

                    <Label text="{i18n>lblJobRole}" required="true"/>

                    <ComboBox
                        selectedKey="{form>/emp/designation_ID}"
                        placeholder="{i18n>phJobRole}"
                        items="{
                            path: '/Designations',
                            sorter: {
                                path: 'description'
                            }
                        }"
                        valueState="{form>/state/designation_ID}"
                        valueStateText="{form>/msg/designation_ID}"
                        selectionChange=".onDesignationChange">

                        <core:Item
                            key="{ID}"
                            text="{description}"/>

                    </ComboBox>

                    <Label text="{i18n>lblLocation}"/>
                    <Input
                        value="{form>/emp/location}"
                        maxLength="100"
                        valueState="{form>/state/location}"
                        valueStateText="{form>/msg/location}"
                        change=".onLocationChange"/>

                    <Label text="{i18n>lblJoiningDate}" required="true"/>
                    <DatePicker
                        dateValue="{form>/emp/joiningDate}"
                        displayFormat="dd MMM yyyy"
                        valueState="{form>/state/joiningDate}"
                        valueStateText="{form>/msg/joiningDate}"
                        change=".onJoiningDateChange"/>

                    <Label text="{i18n>lblStatus}"/>
                    <Select
                        selectedKey="{form>/emp/status}"
                        valueState="{form>/state/status}"
                        valueStateText="{form>/msg/status}"
                        change=".onStatusChange">

                        <core:Item
                            key="Active"
                            text="{i18n>statusActive}"/>

                        <core:Item
                            key="Inactive"
                            text="{i18n>statusInactive}"/>

                    </Select>

                </f:content>

            </f:SimpleForm>

        </content>

        <beginButton>
            <Button
                text="{i18n>save}"
                type="Emphasized"
                press=".onSaveEdit"/>
        </beginButton>

        <endButton>
            <Button
                text="{i18n>cancel}"
                press=".onCancelEdit"/>
        </endButton>

    </Dialog>

</core:FragmentDefinition>
