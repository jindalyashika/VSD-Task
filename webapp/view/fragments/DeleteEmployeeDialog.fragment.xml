<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
  <Dialog id="deleteDialog" title="{i18n>deleteEmployeeTitle}" state="Warning"
    contentWidth="30rem" stretch="{device>/system/phone}">
    <content>
      <MessageStrip text="{i18n>confirmDelete}" type="Warning" showIcon="true"
        class="sapUiSmallMargin"/>
      <f:SimpleForm editable="false" layout="ResponsiveGridLayout"
        labelSpanXL="4" labelSpanL="4" labelSpanM="4" labelSpanS="12"
        columnsXL="1" columnsL="1" columnsM="1">
        <f:content>
          <Label text="{i18n>lblEmployeeId}"/>
          <Text text="{form>/emp/employeeId}"/>
          <Label text="{i18n>colName}"/>
          <Text text="{form>/emp/name}"/>
          <Label text="{i18n>lblEmail}"/>
          <Text text="{form>/emp/email}"/>
          <Label text="{i18n>lblDepartment}"/>
          <Text text="{form>/emp/department}"/>
          <Label text="{i18n>lblJobRole}"/>
          <Text text="{form>/emp/designation}"/>
        </f:content>
      </f:SimpleForm>
    </content>
    <beginButton>
      <Button text="{i18n>delete}" type="Reject" press=".onConfirmDelete"/>
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCancelDelete"/>
    </endButton>
  </Dialog>
</core:FragmentDefinition>