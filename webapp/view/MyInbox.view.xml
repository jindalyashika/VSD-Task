<mvc:View
    controllerName="project1.controller.MyInbox"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    height="100%">

    <f:FlexibleColumnLayout
        id="fcl"
        layout="OneColumn"
        backgroundDesign="Solid">

        <!-- ============ COLUMN 1: EMPLOYEES ============ -->
        <f:beginColumnPages>
            <Page
                id="employeesPage"
                title="Employees"
                showNavButton="true"
                navButtonPress=".onNavBack"
                backgroundDesign="List">

                <headerContent>
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="Refresh"
                        type="Transparent"
                        press=".onRefreshEmployees" />
                </headerContent>

                <subHeader>
                    <Toolbar>
                        <SearchField
                            placeholder="Search employees"
                            width="100%"
                            liveChange=".onEmployeeSearch"
                            search=".onEmployeeSearch" />
                    </Toolbar>
                </subHeader>

                <content>
                    <List
                        id="employeeList"
                        items="{inbox>/employees}"
                        mode="SingleSelectMaster"
                        selectionChange=".onEmployeeSelect"
                        updateFinished=".onEmployeeListUpdateFinished"
                        growing="true"
                        growingThreshold="50"
                        sticky="HeaderToolbar"
                        busy="{inbox>/busy/employees}"
                        busyIndicatorDelay="0"
                        noDataText="No employees found">

                        <headerToolbar>
                            <OverflowToolbar>
                                <Title
                                    text="{= ${inbox>/employeeCount} + ' Employees' }"
                                    level="H5" />
                            </OverflowToolbar>
                        </headerToolbar>

                        <CustomListItem>
                            <HBox
                                alignItems="Center"
                                class="sapUiSmallMargin">
                                <Avatar
                                    initials="{inbox>initials}"
                                    displaySize="S"
                                    backgroundColor="Accent6"
                                    class="sapUiSmallMarginEnd" />
                                <VBox>
                                    <Title
                                        text="{inbox>employeeName}"
                                        titleStyle="H6"
                                        wrapping="true" />
                                    <Text
                                        text="{inbox>subtitle}"
                                        visible="{= !!${inbox>subtitle} }"
                                        class="sapUiTinyMarginTop" />
                                </VBox>
                            </HBox>
                        </CustomListItem>
                    </List>
                </content>
            </Page>
        </f:beginColumnPages>

        <!-- ============ COLUMN 2: LEAVE REQUESTS ============ -->
        <f:midColumnPages>
            <Page
                id="leavesPage"
                title="Leave Requests"
                backgroundDesign="List">

                <headerContent>
                    <Button
                        icon="sap-icon://refresh"
                        tooltip="Refresh"
                        type="Transparent"
                        press=".onRefreshLeaves" />
                    <Button
                        icon="sap-icon://decline"
                        tooltip="Close"
                        type="Transparent"
                        press=".onCloseLeaves" />
                </headerContent>

                <subHeader>
                    <Toolbar>
                        <SearchField
                            id="leaveSearch"
                            placeholder="Search by leave type or reason"
                            width="100%"
                            liveChange=".onLeaveSearch"
                            search=".onLeaveSearch" />
                    </Toolbar>
                </subHeader>

                <content>
                    <List
                        id="leaveList"
                        items="{inbox>/leaves}"
                        mode="SingleSelectMaster"
                        selectionChange=".onLeaveSelect"
                        updateFinished=".onLeaveListUpdateFinished"
                        growing="true"
                        growingThreshold="25"
                        sticky="HeaderToolbar"
                        busy="{inbox>/busy/leaves}"
                        busyIndicatorDelay="0"
                        noDataText="No leave requests found">

                        <headerToolbar>
                            <OverflowToolbar>
                                <Title
                                    text="{= (${inbox>/selectedEmployee/employeeName} || 'Employee') + ' (' + ${inbox>/counts/all} + ')' }"
                                    level="H5" />
                                <ToolbarSpacer />
                                <Select
                                    id="statusFilter"
                                    selectedKey="All"
                                    autoAdjustWidth="true"
                                    change=".onStatusFilter">
                                    <core:Item key="All" text="{= 'All (' + ${inbox>/counts/all} + ')' }" />
                                    <core:Item key="Pending" text="{= 'Pending (' + ${inbox>/counts/pending} + ')' }" />
                                    <core:Item key="Approved" text="{= 'Approved (' + ${inbox>/counts/approved} + ')' }" />
                                    <core:Item key="Rejected" text="{= 'Rejected (' + ${inbox>/counts/rejected} + ')' }" />
                                </Select>
                            </OverflowToolbar>
                        </headerToolbar>

                        <CustomListItem highlight="{inbox>statusState}">
                            <VBox class="sapUiSmallMargin">
                                <HBox
                                    justifyContent="SpaceBetween"
                                    alignItems="Center">
                                    <Title
                                        text="{inbox>leaveType}"
                                        titleStyle="H6"
                                        wrapping="true" />
                                    <ObjectStatus
                                        text="{inbox>status}"
                                        state="{inbox>statusState}"
                                        icon="{inbox>statusIcon}"
                                        inverted="true" />
                                </HBox>
                                <ObjectAttribute
                                    text="{inbox>startDateFormatted} to {inbox>endDateFormatted} ({inbox>durationText})"
                                    class="sapUiTinyMarginTop" />
                            </VBox>
                        </CustomListItem>
                    </List>
                </content>
            </Page>
        </f:midColumnPages>

        <!-- ============ COLUMN 3: LEAVE DETAILS ============ -->
        <f:endColumnPages>
            <Page
                id="detailPage"
                title="Leave Request"
                enableScrolling="true"
                busy="{inbox>/busy/leaves}"
                busyIndicatorDelay="0">

                <headerContent>
                    <Button
                        icon="sap-icon://decline"
                        tooltip="Close"
                        type="Transparent"
                        press=".onCloseDetail" />
                </headerContent>

                <content>
                    <VBox visible="{= !!${inbox>/selectedLeave} }">

                        <ObjectHeader
                            title="{inbox>/selectedLeave/employeeName}"
                            intro="{inbox>/selectedLeave/leaveType}"
                            responsive="true"
                            backgroundDesign="Translucent">
                            <statuses>
                                <ObjectStatus
                                    text="{inbox>/selectedLeave/status}"
                                    state="{inbox>/selectedLeave/statusState}"
                                    icon="{inbox>/selectedLeave/statusIcon}"
                                    inverted="true" />
                            </statuses>
                            <attributes>
                                <ObjectAttribute
                                    title="Duration"
                                    text="{inbox>/selectedLeave/durationText}" />
                                <ObjectAttribute
                                    title="Period"
                                    text="{inbox>/selectedLeave/startDateFormatted} to {inbox>/selectedLeave/endDateFormatted}" />
                            </attributes>
                        </ObjectHeader>

                        <Panel
                            headerText="Leave Details"
                            width="auto"
                            class="sapUiResponsiveMargin">
                            <form:SimpleForm
                                editable="false"
                                layout="ColumnLayout"
                                columnsM="1"
                                columnsL="1"
                                columnsXL="2">
                                <Label text="Leave Type" />
                                <Text text="{inbox>/selectedLeave/leaveType}" />

                                <Label text="Status" />
                                <ObjectStatus
                                    text="{inbox>/selectedLeave/status}"
                                    state="{inbox>/selectedLeave/statusState}"
                                    icon="{inbox>/selectedLeave/statusIcon}" />

                                <Label text="Start Date" />
                                <Text text="{inbox>/selectedLeave/startDateFormatted}" />

                                <Label text="End Date" />
                                <Text text="{inbox>/selectedLeave/endDateFormatted}" />

                                <Label text="Duration" />
                                <Text text="{inbox>/selectedLeave/durationText}" />

                                <Label text="Reason" />
                                <Text text="{inbox>/selectedLeave/reasonText}" />
                            </form:SimpleForm>
                        </Panel>

                        <Panel
                            headerText="Approval"
                            width="auto"
                            class="sapUiResponsiveMargin">
                            <form:SimpleForm
                                editable="false"
                                layout="ColumnLayout"
                                columnsM="1"
                                columnsL="1"
                                columnsXL="2">
                                <Label text="Approver" />
                                <Text text="{inbox>/selectedLeave/approverText}" />

                                <Label text="Comments" />
                                <Text text="{inbox>/selectedLeave/commentsText}" />
                            </form:SimpleForm>
                        </Panel>

                        <Panel
                            headerText="Reference"
                            width="auto"
                            expandable="true"
                            expanded="false"
                            class="sapUiResponsiveMargin">
                            <form:SimpleForm
                                editable="false"
                                layout="ColumnLayout"
                                columnsM="1"
                                columnsL="1"
                                columnsXL="1">
                                <Label text="Employee ID" />
                                <Text text="{inbox>/selectedLeave/employee_ID}" />

                                <Label text="Leave Request ID" />
                                <Text text="{inbox>/selectedLeave/ID}" />
                            </form:SimpleForm>
                        </Panel>
                    </VBox>
                </content>
            </Page>
        </f:endColumnPages>

    </f:FlexibleColumnLayout>
</mvc:View>